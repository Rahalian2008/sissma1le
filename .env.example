APP_NAME="SISSMA 1 Lengkong"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://namadomainanda.com

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ============================================================
# KONFIGURASI DATABASE MYSQL HOSTINGER
# ============================================================
# Sesuaikan nama database, username, dan password yang dibuat
# pada menu "Databases / Manajemen MySQL" di hPanel Hostinger.
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u123456789_presensi
DB_USERNAME=u123456789_presensi
DB_PASSWORD=PasswordDatabaseHostingerAnda

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ============================================================
# KONFIGURASI EMAIL (HOSTINGER SMTP)
# ============================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=admin@namadomainanda.com
MAIL_PASSWORD=PasswordEmailHostingerAnda
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="admin@namadomainanda.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# GOOGLE GEMINI AI
# ============================================================
# Dapatkan API key gratis di: https://aistudio.google.com/app/apikey
# Atau masukkan melalui menu Web UI: Pengaturan Sistem & Geofence
# ============================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
