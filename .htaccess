<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent direct access to sensitive and environment files
    <FilesMatch "(^\..*|composer\.(json|lock)|package(-lock)?\.json|\.env.*|artisan|README\.md|phpunit\.xml)$">
        Require all denied
    </FilesMatch>

    # Deny access to sensitive project directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests)/ - [F,L,NC]

    # Forward all other requests to the public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
